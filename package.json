{
  "name": "lanforge-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Suite e2e de LAN Forge (Playwright) contra el servidor HTTP real.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:install-browsers": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
